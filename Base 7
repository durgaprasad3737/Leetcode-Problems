Question :
Given an integer num, return a string of its base 7 representation.

 

Example 1:
Input: num = 100
Output: "202"

Example 2:
Input: num = -7
Output: "-10"

sol:
class Solution:
    def convertToBase7(self, num: int) -> str:
        if num == 0:
            return "0"

        sign=""
        if num<0:
            sign ="-"
            num = abs(num)

        n = []
        while num != 0:
            a = num % 7
            n.append(a)
            num = num // 7

        n.reverse()
        return sign + "".join(map(str, n))
